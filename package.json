{
  "name": "@watzon/tgmcp",
  "version": "0.1.0",
  "description": "MCP server that automates a Telegram user account through the user API.",
  "type": "module",
  "license": "MIT",
  "author": "Chris Watson <cawatson1993@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watzon/tgmcp.git"
  },
  "bugs": {
    "url": "https://github.com/watzon/tgmcp/issues"
  },
  "homepage": "https://github.com/watzon/tgmcp#readme",
  "keywords": [
    "telegram",
    "mcp",
    "mcp-server",
    "mtcute",
    "node"
  ],
  "bin": {
    "tgmcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "mcp": "bun src/index.ts",
    "login": "bun src/cli.ts login",
    "status": "bun src/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "cli": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outfile dist/cli.js --packages external --banner '#!/usr/bin/env node'",
    "prepublishOnly": "bun test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mtcute/core": "^0.31.0",
    "@mtcute/node": "0.31.0",
    "better-sqlite3": "^13.0.3",
    "qrcode": "^1.5.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.0"
  }
}

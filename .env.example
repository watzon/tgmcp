# Optional. After the first login these also live in storage/credentials.json.
# Env values override the credentials file when both exist.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Route Telegram traffic through a SOCKS or MTProxy endpoint.
# Overrides telegram.proxy in tgmcp.config.json when both are set.
# TGMCP_PROXY=socks5://user:pass@proxy.example.com:1080
# TGMCP_PROXY=mtproxy://proxy.example.com:443?secret=HEX
# TGMCP_PROXY=tg://proxy?server=proxy.example.com&port=443&secret=HEX
